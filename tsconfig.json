{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.d.ts",
    "components/**/*.astro",
    "main.ts",
    "astro.d.ts"
  ]
}

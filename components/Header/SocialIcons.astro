---
import { Github } from 'simple-icons-astro'
import {SocialLinks} from "./SocialLinks.ts";

interface Props {
    socialLinks: readonly SocialLinks[]
}

const { socialLinks }: Props = Astro.props;
---

<div class="social-icons">
    {
        socialLinks.map(({type, link}) => <a href={link}>
            {{"github": <Github />}[type]}
        </a>)
    }
</div>

<style>
    .social-icons {
        display: flex;
        gap: 8px;
    }

    .social-icons a {
        color: var(--foreground-color);
        opacity: 0.7;
    }

    .social-icons a:hover {
        opacity: 1;
    }
</style>